/* The floating island. The window is transparent; only .pill / .island are visible and clickable. */
html, body { margin: 0; height: 100%; background: transparent !important; overflow: hidden; }
body { font-family: var(--font-sans); -webkit-font-smoothing: antialiased; user-select: none; }
#root, .stage { height: 100%; }
.stage { display: flex; justify-content: center; align-items: flex-start; padding-top: 6px; box-sizing: border-box; }

/* ---------- Resting pill ---------- */
.pill {
  display: inline-flex; align-items: center; gap: var(--space-3);
  height: 48px; padding: 0 var(--space-5) 0 var(--space-2);
  border-radius: var(--radius-pill);
  background: #0b1211; color: var(--ink);
  border: 1.5px solid #2a3a38;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
  font: inherit; font-size: 18px; line-height: 24px; font-weight: 600; white-space: nowrap;
  cursor: pointer;
}
.pill:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
.pill.is-error { border-color: var(--caution-ink); }
.pill-name { font-weight: 800; letter-spacing: -.01em; }
.pill-sub { color: var(--ink-muted); font-weight: 600; }

/* ---------- The island cascade ---------- */
.island {
  width: 560px; box-sizing: border-box;
  border-radius: 30px; overflow: hidden;
  background: #0b1211; color: var(--ink);
  border: 1.5px solid #2a3a38;
  box-shadow: 0 14px 40px rgba(0, 0, 0, .5);
  /* It grows out of the pill: starts as a pill-sized clip at the top, opens to the full card. */
  animation: island-drop .62s cubic-bezier(.2, .9, .25, 1.08) both;
}
@keyframes island-drop {
  0% { clip-path: inset(0 22% calc(100% - 50px) 22% round 25px); }
  35% { clip-path: inset(0 0 calc(100% - 64px) 0 round 30px); }
  100% { clip-path: inset(0 0 0 0 round 30px); }
}

.island-head {
  display: flex; align-items: center; gap: var(--space-3);
  height: 64px; padding: 0 var(--space-2) 0 var(--space-5);
  background: var(--scam); color: var(--on-scam);
  animation: head-glow 1.4s ease-in-out .6s 2;
}
@keyframes head-glow { 50% { filter: brightness(1.12); } }
.alert-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.alert-title { font-size: 20px; line-height: 24px; font-weight: 800; }
.alert-sub { font-size: 18px; line-height: 22px; font-weight: 600; opacity: .9; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.alert-more { font-family: var(--font-mono); font-size: 18px; font-weight: 600; padding: 0 var(--space-2); border-radius: var(--radius-pill); background: rgba(0, 0, 0, .18); }
.alert-x { font: inherit; font-size: 24px; line-height: 1; width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; background: transparent; color: inherit; }
.alert-x:hover { background: rgba(0, 0, 0, .15); }

.island-body { padding: var(--space-4) var(--space-5) var(--space-5); }
.island-inner { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: start; }
.island-cat { padding-top: var(--space-2); animation: cat-in .5s cubic-bezier(.2, .9, .3, 1.3) .38s both; }
@keyframes cat-in { from { opacity: 0; transform: translateY(18px) scale(.85); } to { opacity: 1; transform: none; } }

.say-lead { margin: 0 0 var(--space-2); font-size: 18px; line-height: 24px; font-weight: 700; color: var(--ink-muted); animation: fade-up .35s ease-out .62s both; }
.reasons { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
/* One reason at a time, so the eye reads one idea, then the next. */
.reasons li {
  display: flex; flex-direction: column; gap: 2px;
  padding: var(--space-2) var(--space-3); border-radius: var(--radius-md);
  background: #172221; border: 2px solid transparent;
  font-size: 20px; line-height: 26px; font-weight: 600;
  animation: fade-up .42s ease-out both; animation-delay: calc(.8s + var(--i) * .6s);
  transition: border-color .2s ease, background-color .2s ease;
}
.reasons li.is-spoken { border-color: var(--brand); background: #12323a; }
.quote { font-size: 18px; line-height: 24px; font-weight: 500; color: var(--ink-muted); }
@keyframes fade-up { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

.island-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); animation: fade-up .42s ease-out both; animation-delay: calc(.8s + var(--n) * .6s); }
.btn-play, .btn-more { font: inherit; font-size: 20px; font-weight: 800; min-height: 56px; padding: 0 var(--space-5); border-radius: var(--radius-pill); cursor: pointer; display: inline-flex; align-items: center; gap: var(--space-2); }
.btn-play { background: var(--brand); color: var(--on-brand); border: 0; }
.btn-play:hover { background: var(--brand-strong); }
.btn-play.is-playing { box-shadow: 0 0 0 4px rgba(124, 196, 209, .25); }
.btn-more { background: transparent; color: var(--ink); border: 2px solid var(--line-strong); }
.btn-more:hover { background: #172221; }
.btn-play:focus-visible, .btn-more:focus-visible, .alert-x:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }

/* The cat talks while the audio plays. */
.is-talking .ss-cat-mouth { transform-box: fill-box; transform-origin: center; animation: cat-talk .24s ease-in-out infinite alternate; }
@keyframes cat-talk { from { transform: scaleY(.35); } to { transform: scaleY(1.15); } }

@media (prefers-reduced-motion: reduce) {
  .island, .island-head, .island-cat, .say-lead, .reasons li, .island-actions { animation: none; }
  .is-talking .ss-cat-mouth { animation: none; }
}
